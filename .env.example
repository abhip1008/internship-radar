# Copy to .env and fill in what you want. Everything here is OPTIONAL — the
# pipeline runs fully offline without any of these (deterministic fallbacks).
# NEVER commit the real .env.

# Instant phone alerts for Seattle-area, high-fit postings (spec §8).
DISCORD_WEBHOOK=
NTFY_TOPIC=

# LLM re-angling for resumes + notes (spec §10, §11). Free tier: Gemini.
# Without a key, tailoring/notes fall back to a deterministic path.
GEMINI_API_KEY=
